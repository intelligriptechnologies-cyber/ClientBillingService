# Copy to .env.staging / .env.production on the server (never commit them).
# These are read by the app (src/lib/tenant-store.ts).

# SQLite file. The Docker image defaults to /data/client-billing.sqlite on a mounted volume.
# When unset outside Docker the app uses .data/client-billing.sqlite.
CLIENT_BILLING_DATABASE=/data/client-billing.sqlite

# "demo" creates an empty database on first start. Any other value (or empty) copies
# seed/initial-data.sqlite on first start. Leave empty in production.
CLIENT_BILLING_SEED_MODE=

# Postgres (ADR 0001). The values below match `npm run db:up` (docker-compose.dev.yml, host port 5433) and are
# dev-only placeholders. Real servers set their own passwords in .env.staging / .env.production, never here.
# The app reads DATABASE_URL (role cbs_app, no ownership, no BYPASSRLS) and DATABASE_PLATFORM_URL (role
# cbs_platform, BYPASSRLS, withPlatform only). Only the migrator, the seed and the SQLite import read
# DATABASE_MIGRATE_URL (role cbs_owner). With DATABASE_MIGRATE_URL set, src/lib/db/roles.test.ts runs; without it
# the test skips by name. Nothing reads these three at runtime until ADR 0001 unit D11.
DATABASE_URL=postgres://cbs_app:cbs_app_dev_only@localhost:5433/cbs
DATABASE_PLATFORM_URL=postgres://cbs_platform:cbs_platform_dev_only@localhost:5433/cbs
DATABASE_MIGRATE_URL=postgres://cbs_owner:cbs_owner_dev_only@localhost:5433/cbs

# Sign-in (ADR 0002). CLIENT_BILLING_ENV is one of development, test, staging, demo, production;
# empty means development. CLIENT_BILLING_AUTH_MODE is demo (the default; an identity picker) or
# authelia (trusts headers that Caddy copies from Authelia). The app refuses to start, and answers
# 503, when CLIENT_BILLING_ENV=production is combined with demo mode. Set CLIENT_BILLING_ENV on
# every server, because an unset value counts as development and leaves that guard off.
CLIENT_BILLING_ENV=
CLIENT_BILLING_AUTH_MODE=
# Required in authelia mode only. The secret is at least 32 bytes and must match Caddy's X-CBS-Proxy-Secret.
CBS_PROXY_SECRET=
CBS_AUTH_MEMBER_GROUP=
CBS_AUTH_SUPERADMIN_GROUP=
CBS_AUTHELIA_LOGOUT_URL=
# Optional. The exact public origin (scheme and host) that the Origin check expects on state-changing
# requests. When empty the check compares Origin with the Host header and X-Forwarded-Proto.
# CBS_PUBLIC_ORIGIN=

# PDF rendering uses headless Chromium. The Docker image installs it and sets these.
# Outside Docker run `npx playwright install chromium`, or point at an existing executable.
# CLIENT_BILLING_CHROMIUM_PATH=
# CLIENT_BILLING_CHROMIUM_NO_SANDBOX=1

# Outgoing email (invoice delivery and payment reminders). Each tenant stores its own SMTP host, port, user,
# password and From address under Settings, Email. Nothing is sent until a tenant has a host and a From address.
# Credentials are only offered over TLS: port 465 uses implicit TLS and other ports must offer STARTTLS.
# "capture" writes messages to a JSON file instead of sending them, for tests and the verify instance. The app
# ignores it when CLIENT_BILLING_ENV=production. The file defaults to mail-capture.json beside the database.
# CLIENT_BILLING_MAIL_TRANSPORT=capture
# CLIENT_BILLING_MAIL_CAPTURE_FILE=

# Test-only (playwright.config.ts). The app does not read these.
# CLIENT_BILLING_TEST_PORT=3100
# CLIENT_BILLING_TEST_USE_START=
