# Copy to .env.staging / .env.production on the server (never commit them).
# These are read by the app (src/lib/tenant-store.ts).

# SQLite file. The Docker image defaults to /data/client-billing.sqlite on a mounted volume.
# When unset outside Docker the app uses .data/client-billing.sqlite.
CLIENT_BILLING_DATABASE=/data/client-billing.sqlite

# "demo" creates an empty database on first start. Any other value (or empty) copies
# seed/initial-data.sqlite on first start. Leave empty in production.
CLIENT_BILLING_SEED_MODE=

# Test-only (playwright.config.ts). The app does not read these.
# CLIENT_BILLING_TEST_PORT=3100
# CLIENT_BILLING_TEST_USE_START=
