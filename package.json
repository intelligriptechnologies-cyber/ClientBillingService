{
  "name": "client-billing-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:async-store": "node scripts/codemods/async-store.ts --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:migrate": "node-pg-migrate up -m db/migrations -d DATABASE_MIGRATE_URL",
    "db:seed": "node db/seed/demo.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "argon2": "0.45.1",
    "next": "^16.3.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.0.11",
    "pg": "^8.23.1",
    "playwright-core": "1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/smtp-server": "3.5.13",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.3.0",
    "pdfjs-dist": "^6.4.299",
    "smtp-server": "3.19.14",
    "ts-morph": "28.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
