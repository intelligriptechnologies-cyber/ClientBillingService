# Shared Hetzner Caddy routes. Each app verifies its own password and session.
# The edge secret authenticates the proxy connection, never the end user.
(cbs_shared_site) {
    encode gzip zstd
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
    }
    route {
        request_header -Remote-*
        request_header X-CBS-Proxy-Secret {args[1]}
        request_header X-CBS-Client-IP {remote_host}
        reverse_proxy {args[0]}
    }
}

billing-staging.nexiohyper.com {
    import cbs_shared_site app-staging:3000 {$CBS_STAGING_PROXY_SECRET}
}

billing.nexiohyper.com {
    import cbs_shared_site app-production:3000 {$CBS_PRODUCTION_PROXY_SECRET}
}

# Keep rollback portals until independent-login acceptance and a separate retirement review.
auth.billing-staging.nexiohyper.com, auth.billing.nexiohyper.com {
    reverse_proxy {$CBS_AUTHELIA_UPSTREAM}
}
