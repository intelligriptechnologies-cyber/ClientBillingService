# Copy to /opt/client-billing/deploy/caddy/barstock-proxy.env on the Hetzner server and chmod 600.
# These must match CBS_PROXY_SECRET in the matching Client Billing application environment file.
CBS_STAGING_PROXY_SECRET=replace-with-staging-secret
CBS_PRODUCTION_PROXY_SECRET=replace-with-production-secret

# The host gateway endpoint currently used by the shared Cowork/Barstock routing configuration.
# Confirm this remains reachable from barstock-production-proxy-1 before the first deployment.
CBS_AUTHELIA_UPSTREAM=172.19.0.1:19091
