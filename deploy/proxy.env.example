# Copy to deploy/proxy.env on the server. Read only by the Caddy container.
# The two domains are siblings. Never nest staging under production: Authelia's cookie for billing.example.com
# is also sent to staging.billing.example.com (ADR 0002, Consequences). Each site's sign-in page is auth.<domain>.
STAGING_DOMAIN=billing-staging.example.com
PRODUCTION_DOMAIN=billing.example.com
# Must equal CBS_PROXY_SECRET in .env.staging and .env.production. At least 32 bytes, one per environment, for
# example the output of `openssl rand -hex 32`. Caddy adds it as X-CBS-Proxy-Secret on every proxied request.
STAGING_PROXY_SECRET=
PRODUCTION_PROXY_SECRET=
# Where Caddy reaches Authelia (forward_auth and the sign-in page). Default authelia:9091.
# AUTHELIA_UPSTREAM=authelia:9091
